{
  "url": "http://127.0.0.1:8231/pomodoro-focus/?debug=1",
  "steps": [
    {
      "op": "click",
      "selector": "[data-testid=btn-start]:not([hidden])"
    },
    {
      "op": "eval",
      "expression": "(()=>{__pf.advance(__pf.getState().settings.focusMin*60000-10000);return true;})()",
      "expect": "true"
    },
    {
      "op": "eval",
      "expression": "(()=>{__pf.advance(30000);return true;})()",
      "expect": "true"
    },
    {
      "op": "waitMs",
      "ms": 1500
    },
    {
      "op": "eval",
      "expression": "(()=>{var g=function(id){return document.querySelector('[data-testid='+id+']').innerText.trim();};return g('phase-label')==='专注'&&g('time-display')==='00:00'&&g('status-label')==='已结束'&&Number(document.querySelector('[data-testid=progress]').getAttribute('aria-valuenow'))===100;})()",
      "expect": "true"
    },
    {
      "op": "eval",
      "expression": "document.title==='✓ 专注结束'",
      "expect": "true"
    },
    {
      "op": "assertText",
      "text": "第 2 轮"
    },
    {
      "op": "waitMs",
      "ms": 1200
    },
    {
      "op": "eval",
      "expression": "(()=>{var g=function(id){return document.querySelector('[data-testid='+id+']').innerText.trim();};return g('phase-label')==='专注'&&g('status-label')==='已结束'&&g('round-count')==='第 2 轮';})()",
      "expect": "true"
    },
    {
      "op": "click",
      "selector": "[data-testid=btn-start]:not([hidden])"
    },
    {
      "op": "waitMs",
      "ms": 700
    },
    {
      "op": "eval",
      "expression": "(()=>{var g=function(id){return document.querySelector('[data-testid='+id+']').innerText.trim();};return g('phase-label')==='短休息'&&g('time-display')==='05:00';})()",
      "expect": "true"
    }
  ]
}